[Unit]
Description=SQRL raw-JTAG bridge for FK33 %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=LANG=C
Environment=LC_ALL=C
EnvironmentFile=%h/.config/fk33-fjar-miner/miner.env
EnvironmentFile=%h/.config/fk33-fjar-miner/cards/%i.env
ExecStartPre=/bin/bash -c 'test "$(grep -l "^%i$" /sys/bus/usb/devices/*/serial 2>/dev/null | wc -l)" -eq 1'
ExecStartPre=/bin/bash -c '! /usr/bin/ss -ltnH | /usr/bin/grep -Eq ":${FJAR_HW_PORT}[[:space:]]"'
ExecStart=/bin/bash -c 'set -e; run="%h/.local/state/fk33-fjar-miner/%i/sqrl"; mkdir -p "$run"; chmod 700 "$run"; cd "$run"; : > virtual_ports; chmod 600 virtual_ports; export LD_LIBRARY_PATH="%h/.local/share/fk33-fjar-miner/private/compat_libs"; exec "%h/.local/share/fk33-fjar-miner/private/bin/sqrl_bridge_rawjtag_coe" -s ",%i" -b "%h/.local/share/fk33-fjar-miner/current/hardware/prebuilt/fk33_fjar_bscan_350.bit" -p "$FJAR_HW_PORT" -t -f "%h/.local/state/fk33-fjar-miner/%i/sqrl.log"'
StandardOutput=append:%h/.local/state/fk33-fjar-miner/%i/sqrl-stdout.log
StandardError=append:%h/.local/state/fk33-fjar-miner/%i/sqrl-stdout.log
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=default.target
