# Required: standard lowercase FJARCODE address owned by the miner operator.
FJAR_WALLET=fjarcode:replace_with_your_address

# PythonPool FJAR solo endpoint. Change only if intentionally using a
# compatible SHA3-256T Stratum v1 pool.
FJAR_POOL_HOST=stratum.pythonpool.dev
FJAR_POOL_PORT=3358

# Adjust if Vivado is installed elsewhere.
VIVADO_BIN=/home/replace_me/Xilinx/2026.1/Vivado/bin/vivado
