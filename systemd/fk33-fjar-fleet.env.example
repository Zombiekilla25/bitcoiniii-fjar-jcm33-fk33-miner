# Comma-separated exact FK33 USB serials selected by the one fleet bridge.
FJAR_FLEET_SERIALS=SERIAL_A,SERIAL_B

# The bridge assigns consecutive ports beginning here. Card mappings are
# validated against the bridge discovery log before miners start.
FJAR_FLEET_BASE_PORT=22000

# 525 remains the fleet-tested default. Select 650 only for a staged rollout
# after reviewing docs/FK33_NATIVE650.md.
FJAR_FLEET_BITSTREAM=525
