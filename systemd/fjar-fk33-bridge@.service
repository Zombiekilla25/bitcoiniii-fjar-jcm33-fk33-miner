[Unit]
Description=FJAR FK33 pool bridge %i
Wants=network-online.target fjar-fk33-worker@%i.service
After=network-online.target fjar-fk33-worker@%i.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=%h/.config/fk33-fjar-miner/miner.env
Environment=FJAR_SERIAL=%i
Environment=FJAR_WORKER=fk33-%i
WorkingDirectory=-%h/.local/state/fk33-fjar-miner/%i
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/fk33-fjar-miner/%i
ExecStartPre=/bin/bash -c 'for attempt in {1..180}; do [ -s "%h/.local/state/fk33-fjar-miner/%i/vio_status.txt" ] && exit 0; sleep 1; done; exit 1'
ExecStart=/bin/bash -c 'exec 9>"%h/.local/state/fk33-fjar-miner/%i/.bridge.lock"; /usr/bin/flock -n 9 || exit 90; exec /usr/bin/python3 -u "%h/.local/share/fk33-fjar-miner/current/runtime/fjar_bridge.py"'
StandardOutput=append:%h/.local/state/fk33-fjar-miner/%i/bridge.log
StandardError=append:%h/.local/state/fk33-fjar-miner/%i/bridge.log
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
