# Copy this file to config-jcm33-btc3.env and run:
#   chmod 600 config-jcm33-btc3.env

BTC3_WALLET='bc1qYOUR_BITCOINIII_ADDRESS'
BTC3_WORKER='jcm33-dual'
BTC3_POOL_HOST='stratum.pythonpool.dev'
BTC3_POOL_PORT='3357'
BTC3_WORK_ROLL_SECONDS='7.5'

JCM33_CARRIER='192.168.1.222'
JCM33_BASE_PORT='2000'
JCM33_XVC_PORT='2542'

# Point this at the operator-provided ABI-5 compatibility libraries when the
# host does not already provide libncurses.so.5 and libtinfo.so.5.
JCM33_LIB_DIR="$HOME/jc33_compat_libs"

# Optional overrides:
# JCM33_STATE_DIR="$HOME/.local/state/jcm33-btc3"
# JCM33_START_TIMEOUT='420'
# JCM33_STOP_TIMEOUT='240'
